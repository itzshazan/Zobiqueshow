{
  "name": "zobique-site",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/content-guard.mjs --production",
    "build": "next build",
    "postbuild": "node scripts/content-guard.mjs --scan-build",
    "start": "next start",
    "check:content": "node scripts/content-guard.mjs",
